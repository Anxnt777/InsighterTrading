# ==============================================================
# InsighterTrading Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# Copy this file to .env in each corresponding service directory.
# ==============================================================

# Backend (Spring Boot)
SERVER_PORT=8080
AI_SERVICE_URL=http://localhost:8000
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL)
POSTGRES_DB=insighter_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AI Service (FastAPI)
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_DEBUG=true

# Financial News APIs (Optional / Milestone 2)
# Free tier API key from finnhub.io or newsapi.org
FINNHUB_API_KEY=your_finnhub_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
